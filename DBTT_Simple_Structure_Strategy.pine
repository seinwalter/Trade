//@version=6
strategy("DBTT Hybrid ORB + Bias v2.0.0",
     overlay = true,
     pyramiding = 0,
     initial_capital = 100000,
     margin_long = 0,
     margin_short = 0,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     process_orders_on_close = false)
//=============================================================================
// INPUTS
//=============================================================================
g_orb = "Opening Range"
orSession    = input.session("0930-1000", "OR Window", group = g_orb)
minORRange   = input.float(2.0,  "Min OR Range (pts)", step = 0.25, minval = 0, group = g_orb)
maxORRange   = input.float(15.0, "Max OR Range (pts)", step = 0.25, minval = 0, group = g_orb)
showORLevels = input.bool(true, "Show OR Levels", group = g_orb)

g_bias = "Structure Bias"
ltfTF          = input.timeframe("5",  "LTF", group = g_bias)
mtfTF          = input.timeframe("15", "MTF", group = g_bias)
swingLen       = input.int(10, "Swing Lookback", minval = 3, maxval = 50, group = g_bias)
requireBothTFs = input.bool(true, "Require LTF + MTF Alignment", group = g_bias)

g_filt = "Filters"
tradeSide     = input.string("Both", "Trade Side", options = ["Both", "Long Only", "Short Only"], group = g_filt)
sessionTZ     = input.string("America/New_York", "Session Timezone", options = ["America/New_York", "America/Chicago", "UTC", "Europe/London"], group = g_filt)
useRTH        = input.bool(true, "Only Trade RTH", group = g_filt)
rthSession    = input.session("0930-1600", "RTH Session", group = g_filt)
useDateFilter = input.bool(false, "Enable Date Filter", group = g_filt)
dateStart     = input.time(timestamp("2025-01-01 00:00 +0000"), "Start Date", group = g_filt)
dateEnd       = input.time(timestamp("2026-12-31 23:59 +0000"), "End Date", group = g_filt)

g_tgt = "Targets / Stops"
profile    = input.string("MNQ", "Profile", options = ["MNQ", "ES"], group = g_tgt)
mnqTP1In   = input.float(6.0,  "MNQ TP1 (pts)", step = 0.25, group = g_tgt)
mnqTP2In   = input.float(20.0, "MNQ TP2 (pts)", step = 0.25, group = g_tgt)
mnqTP3In   = input.float(50.0, "MNQ TP3 (pts)", step = 0.25, group = g_tgt)
esTP1In    = input.float(1.5,  "ES TP1 (pts)", step = 0.25, group = g_tgt)
esTP2In    = input.float(3.0,  "ES TP2 (pts)", step = 0.25, group = g_tgt)
esTP3In    = input.float(7.0,  "ES TP3 (pts)", step = 0.25, group = g_tgt)
stopMode   = input.string("OR Range", "Stop Mode", options = ["OR Range", "Fixed"], group = g_tgt)
stopBuffer = input.float(0.5,  "Stop Buffer (pts)", step = 0.25, tooltip = "Added beyond OR opposite side", group = g_tgt)
fixedSL    = input.float(10.0, "Fixed SL (pts)", step = 0.25, tooltip = "Used when Stop Mode = Fixed", group = g_tgt)

g_exec = "Execution"
contracts      = input.int(3, "Total Contracts", minval = 1, group = g_exec)
tp1QtyIn       = input.int(1, "TP1 Contracts", minval = 0, group = g_exec)
tp2QtyIn       = input.int(1, "TP2 Contracts", minval = 0, group = g_exec)
beOffsetPts    = input.float(0.0, "BE Offset (pts)", step = 0.25, group = g_exec)
forceFlatRTH   = input.bool(true, "Force Flat At RTH Close", group = g_exec)
maxBarsInTrade = input.int(0, "Max Bars In Trade (0 = off)", minval = 0, group = g_exec)
//=============================================================================
// DERIVED CONSTANTS
//=============================================================================
bool isES  = profile == "ES"
float tp1  = isES ? esTP1In : mnqTP1In
float tp2  = isES ? esTP2In : mnqTP2In
float tp3  = isES ? esTP3In : mnqTP3In
int tp1Q   = math.min(tp1QtyIn, contracts)
int tp2Q   = math.min(tp2QtyIn, contracts - tp1Q)
int tp3Q   = contracts - tp1Q - tp2Q
tp3Q      := tp3Q < 0 ? 0 : tp3Q
//=============================================================================
// STRUCTURE BIAS (non-repainting confirmed pivots)
//=============================================================================
biasCalc(swLen) =>
    pivHi = ta.pivothigh(high, swLen, swLen)
    pivLo = ta.pivotlow(low, swLen, swLen)
    var float prevHi = na
    var float currHi = na
    var float prevLo = na
    var float currLo = na
    var int bias = 0
    if not na(pivHi)
        prevHi := currHi
        currHi := pivHi
    if not na(pivLo)
        prevLo := currLo
        currLo := pivLo
    if not na(prevHi) and not na(currHi) and not na(prevLo) and not na(currLo)
        if currHi > prevHi and currLo > prevLo
            bias := 1
        else if currHi < prevHi and currLo < prevLo
            bias := -1
    bias

int biasLTF = request.security(syminfo.tickerid, ltfTF, biasCalc(swingLen), lookahead = barmerge.lookahead_off)
int biasMTF = request.security(syminfo.tickerid, mtfTF, biasCalc(swingLen), lookahead = barmerge.lookahead_off)
bool biasLong  = biasLTF == 1  and (not requireBothTFs or biasMTF == 1)
bool biasShort = biasLTF == -1 and (not requireBothTFs or biasMTF == -1)
//=============================================================================
// SESSION FILTERS
//=============================================================================
bool inRTH         = not useRTH or not na(time(timeframe.period, rthSession, sessionTZ))
bool rthJustClosed = useRTH and inRTH[1] and not inRTH
bool inDateRange   = not useDateFilter or (time >= dateStart and time <= dateEnd)
bool dateJustEnded = useDateFilter and inDateRange[1] and not inDateRange
//=============================================================================
// OPENING RANGE
//=============================================================================
bool inORWindow = not na(time(timeframe.period, orSession, sessionTZ))

var bool _wasInOR = false
bool orWindowOpen  = inORWindow and not _wasInOR
bool orWindowClose = _wasInOR and not inORWindow

var float orHigh      = na
var float orLow       = na
var bool  orDefined   = false
var bool  orLongTaken = false
var bool  orShortTaken = false

if orWindowOpen
    orHigh       := na
    orLow        := na
    orDefined    := false
    orLongTaken  := false
    orShortTaken := false

if inORWindow
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)

if orWindowClose and not na(orHigh) and not na(orLow)
    orDefined := true

_wasInOR := inORWindow

float orRange = orDefined ? (orHigh - orLow) : na
bool  rangeOk = not na(orRange) and orRange >= minORRange and orRange <= maxORRange
//=============================================================================
// BREAKOUT + BIAS SIGNALS
//=============================================================================
bool canLong  = tradeSide != "Short Only"
bool canShort = tradeSide != "Long Only"

bool orbLongBreak  = orDefined and rangeOk and close > orHigh and not orLongTaken
bool orbShortBreak = orDefined and rangeOk and close < orLow  and not orShortTaken

var int lastEntryBar = na
bool canEnter = na(lastEntryBar) or bar_index > lastEntryBar

bool longSignal  = barstate.isconfirmed and inRTH and inDateRange and orbLongBreak  and biasLong  and canLong  and canEnter
bool shortSignal = barstate.isconfirmed and inRTH and inDateRange and orbShortBreak and biasShort and canShort and canEnter
//=============================================================================
// POSITION STATE
//=============================================================================
float posSize = strategy.position_size
float posAbs  = math.abs(posSize)
bool  isFlat  = posSize == 0
bool  wasFlat = posSize[1] == 0 or na(posSize[1])
bool  newPos  = wasFlat and not isFlat
bool  flatNow = not wasFlat and isFlat
//=============================================================================
// ENTRIES (one per bar, one per direction per session)
//=============================================================================
if isFlat and longSignal
    strategy.entry("L", strategy.long, qty = contracts)
    orLongTaken  := true
    lastEntryBar := bar_index
else if isFlat and shortSignal
    strategy.entry("S", strategy.short, qty = contracts)
    orShortTaken := true
    lastEntryBar := bar_index
//=============================================================================
// TRADE MANAGEMENT
//=============================================================================
var int   entryBar   = na
var float entryPrice = na
var float lockedStop = na
var bool  tp1Hit     = false
var bool  tp2Hit     = false
var bool  tp1Touched = false

if newPos
    entryBar     := bar_index
    entryPrice   := strategy.position_avg_price
    lastEntryBar := bar_index
    tp1Hit       := false
    tp2Hit       := false
    tp1Touched   := false
    float avg = entryPrice
    if posSize > 0
        lockedStop := stopMode == "OR Range" ? (orLow - stopBuffer) : (avg - fixedSL)
    else
        lockedStop := stopMode == "OR Range" ? (orHigh + stopBuffer) : (avg + fixedSL)

if flatNow
    entryBar   := na
    entryPrice := na
    lockedStop := na
    tp1Hit     := false
    tp2Hit     := false
    tp1Touched := false
    strategy.cancel("L-TP1")
    strategy.cancel("L-TP2")
    strategy.cancel("L-TP3")
    strategy.cancel("S-TP1")
    strategy.cancel("S-TP2")
    strategy.cancel("S-TP3")

float entryAbsQty = float(contracts)
if posAbs > 0 and not na(entryPrice)
    float closed = entryAbsQty - posAbs
    closed := closed < 0 ? 0 : closed
    if closed >= float(tp1Q) - 0.001
        tp1Hit := true
    if closed >= float(tp1Q + tp2Q) - 0.001
        tp2Hit := true

float avg = not na(entryPrice) ? entryPrice : strategy.position_avg_price
if posAbs > 0 and not na(avg)
    if posSize > 0 and high >= avg + tp1
        tp1Touched := true
    else if posSize < 0 and low <= avg - tp1
        tp1Touched := true

bool beActive = tp1Touched and tp1Q > 0
//=============================================================================
// FORCE FLAT
//=============================================================================
bool closeForRTH     = forceFlatRTH and rthJustClosed and posAbs > 0
bool closeForDateEnd = dateJustEnded and posAbs > 0
bool closeForMaxBars = maxBarsInTrade > 0 and posAbs > 0 and not na(entryBar) and (bar_index - entryBar) >= maxBarsInTrade
bool forceFlatNow    = closeForRTH or closeForDateEnd or closeForMaxBars

if forceFlatNow
    strategy.close_all(comment = closeForRTH ? "RTH-Flat" : closeForDateEnd ? "DateEnd" : "TimeStop")
    strategy.cancel("L-TP1")
    strategy.cancel("L-TP2")
    strategy.cancel("L-TP3")
    strategy.cancel("S-TP1")
    strategy.cancel("S-TP2")
    strategy.cancel("S-TP3")
//=============================================================================
// EXIT ORDERS (3-TP scale-out + BE after TP1)
//=============================================================================
float needTP1 = 0.0
float needTP2 = 0.0
float needTP3 = 0.0

if posAbs > 0
    needTP1 := (not tp1Hit and tp1Q > 0) ? math.min(float(tp1Q), posAbs) : 0
    float rem1 = math.max(posAbs - needTP1, 0)
    needTP2 := (not tp2Hit and tp2Q > 0) ? math.min(float(tp2Q), rem1) : 0
    needTP3 := math.max(posAbs - needTP1 - needTP2, 0)
    if needTP1 == 0 and needTP2 == 0
        needTP3 := posAbs

if posSize > 0 and not forceFlatNow
    float baseStop = not na(lockedStop) ? lockedStop : (avg - fixedSL)
    float beStop   = avg + beOffsetPts
    if needTP1 > 0
        float lim = avg + tp1
        float st  = baseStop
        st := st >= lim ? lim - syminfo.mintick : st
        strategy.exit("L-TP1", "L", limit = lim, stop = st, qty = needTP1)
    else
        strategy.cancel("L-TP1")
    if needTP2 > 0
        float lim = avg + tp2
        float st  = beActive ? beStop : baseStop
        st := st >= lim ? lim - syminfo.mintick : st
        strategy.exit("L-TP2", "L", limit = lim, stop = st, qty = needTP2)
    else
        strategy.cancel("L-TP2")
    if needTP3 > 0
        float lim = avg + tp3
        float st  = beActive ? beStop : baseStop
        st := st >= lim ? lim - syminfo.mintick : st
        strategy.exit("L-TP3", "L", limit = lim, stop = st, qty = needTP3)
    else
        strategy.cancel("L-TP3")

if posSize < 0 and not forceFlatNow
    float baseStop = not na(lockedStop) ? lockedStop : (avg + fixedSL)
    float beStop   = avg - beOffsetPts
    if needTP1 > 0
        float lim = avg - tp1
        float st  = baseStop
        st := st <= lim ? lim + syminfo.mintick : st
        strategy.exit("S-TP1", "S", limit = lim, stop = st, qty = needTP1)
    else
        strategy.cancel("S-TP1")
    if needTP2 > 0
        float lim = avg - tp2
        float st  = beActive ? beStop : baseStop
        st := st <= lim ? lim + syminfo.mintick : st
        strategy.exit("S-TP2", "S", limit = lim, stop = st, qty = needTP2)
    else
        strategy.cancel("S-TP2")
    if needTP3 > 0
        float lim = avg - tp3
        float st  = beActive ? beStop : baseStop
        st := st <= lim ? lim + syminfo.mintick : st
        strategy.exit("S-TP3", "S", limit = lim, stop = st, qty = needTP3)
    else
        strategy.cancel("S-TP3")
//=============================================================================
// PLOTS
//=============================================================================
ICT_BULL = #089981
ICT_BEAR = #f23645

p_orHi = plot(showORLevels and orDefined ? orHigh : na, "OR High", color = color.new(ICT_BULL, 30), style = plot.style_linebr, linewidth = 2)
p_orLo = plot(showORLevels and orDefined ? orLow  : na, "OR Low",  color = color.new(ICT_BEAR, 30), style = plot.style_linebr, linewidth = 2)
fill(p_orHi, p_orLo, color = showORLevels and orDefined ? color.new(color.gray, 92) : na, title = "OR Range")

plotshape(longSignal  and isFlat, "Long Entry",  shape.triangleup,   location.belowbar, color.new(ICT_BULL, 0), size = size.tiny, text = "L")
plotshape(shortSignal and isFlat, "Short Entry", shape.triangledown, location.abovebar, color.new(ICT_BEAR, 0), size = size.tiny, text = "S")
